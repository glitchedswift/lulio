{
  "id": "2-7",
  "title": { "es": "El tiempo y las estaciones", "ca": "El temps i les estacions" },
  "goal": {
    "es": "Aprende a hablar del tiempo meteorológico, las estaciones y los meses del año en catalán.",
    "ca": "Aprèn a parlar del temps meteorològic, les estacions i els mesos de l'any en català."
  },
  "topics": [
    {
      "id": "t1",
      "title": { "es": "Las estaciones", "ca": "Les estacions" },
      "goal": {
        "es": "Las cuatro estaciones y el truco: «a» + artículo con las estaciones (no «en»).",
        "ca": "Les quatre estacions i el truc: «a» + article (no «en»)."
      },
      "exercises": [
        { "type": "flashcard", "ca": "la primavera", "es": "la primavera" },
        { "type": "flashcard", "ca": "l'estiu", "es": "el verano",
          "note": { "es": "«L'estiu»: masculino, artículo apostrofado.", "ca": "Masculí: l'estiu." } },
        { "type": "flashcard", "ca": "la tardor", "es": "el otoño",
          "note": { "es": "¡Falso amigo! «Tardor» es el otoño, no tardanza.", "ca": "«Tardor» = otoño. No «tardança»." } },
        { "type": "flashcard", "ca": "l'hivern", "es": "el invierno",
          "note": { "es": "«L'hivern»: la h es muda. Masculino.", "ca": "La h és muda. Masculí." } },
        {
          "type": "pattern",
          "rule": { "from": "en + estación", "to": "a + article + estació" },
          "examples": [
            { "es": "en primavera", "ca": "a la primavera" },
            { "es": "en verano", "ca": "a l'estiu" },
            { "es": "en otoño", "ca": "a la tardor" },
            { "es": "en invierno", "ca": "a l'hivern" }
          ],
          "note": {
            "es": "Catalán usa «a» + artículo con estaciones, nunca «en». Masc.: a l'estiu, a l'hivern. Fem.: a la primavera, a la tardor.",
            "ca": "«A» + article amb estacions. Masc.: a l'estiu, a l'hivern. Fem.: a la primavera, a la tardor."
          }
        },
        { "type": "compare",
          "es": "En verano hace mucho calor",
          "ca": "A l'estiu fa molt de calor",
          "note": { "es": "«A l'estiu» = en verano. Recuerda: «a», no «en».", "ca": "«A l'estiu»: preposició «a»." }
        },
        { "type": "compare",
          "es": "En otoño caen las hojas",
          "ca": "A la tardor cauen les fulles",
          "note": { "es": "«Fulles» = hojas.", "ca": "«Fulles» = hojas." }
        },
        { "type": "fill_blank",
          "sentence": "A ___ hi ha molta neu als Pirineus.",
          "translation": "En invierno hay mucha nieve en los Pirineos.",
          "options": ["l'hivern", "l'estiu"],
          "answer": "l'hivern" },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "el otoño", "options": ["la tardor", "la tardança", "l'hivern", "l'estiu"], "answer": "la tardor" },
        { "type": "listen", "ca": "A la primavera plou molt", "options": ["A la primavera plou molt", "A l'estiu plou molt", "A l'hivern plou molt"] }
      ]
    },
    {
      "id": "t2",
      "title": { "es": "El tiempo (meteorológico)", "ca": "El temps (meteorològic)" },
      "goal": {
        "es": "Fa sol, plou, neva. Patrón «fa + nombre» para el tiempo, más verbos directos.",
        "ca": "«Fa + nom» per al temps. Verbs directes: plou, neva."
      },
      "exercises": [
        { "type": "flashcard", "ca": "fa sol", "es": "hace sol" },
        { "type": "flashcard", "ca": "fa vent", "es": "hace viento" },
        {
          "type": "pattern",
          "rule": { "from": "hace + nombre", "to": "fa + nom" },
          "examples": [
            { "es": "hace sol", "ca": "fa sol" },
            { "es": "hace viento", "ca": "fa vent" },
            { "es": "hace calor", "ca": "fa calor" },
            { "es": "hace frío", "ca": "fa fred" }
          ],
          "note": {
            "es": "«Fa» = hace. Mismo patrón que en español para el tiempo. Excepción: plou (llueve) y neva (nieva) son verbos directos, sin «fa».",
            "ca": "«Fa» = hace. Excepcions: plou, neva → verbs directes."
          }
        },
        { "type": "flashcard", "ca": "plou", "es": "llueve" },
        { "type": "flashcard", "ca": "neva", "es": "nieva" },
        { "type": "flashcard", "ca": "hi ha núvols", "es": "hay nubes",
          "note": { "es": "«Núvols» = nubes. Se usa «hi ha» (hay).", "ca": "«Núvols» amb «hi ha»." } },
        { "type": "flashcard", "ca": "fa bon temps", "es": "hace buen tiempo" },
        { "type": "flashcard", "ca": "fa mal temps", "es": "hace mal tiempo" },
        { "type": "compare",
          "es": "Hace calor y mucho sol",
          "ca": "Fa calor i molt de sol",
          "note": { "es": "«Molt de» con sustantivos: molt de sol, molt de fred, molt de vent.", "ca": "«Molt de» + nom." }
        },
        { "type": "fill_blank",
          "sentence": "Avui ___ molt. Porta paraigua!",
          "translation": "Hoy llueve mucho. ¡Lleva paraguas!",
          "options": ["plou", "neva"],
          "answer": "plou" },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "hace viento", "options": ["fa vent", "fa ventosa", "hi ha vent", "plou vent"], "answer": "fa vent" },
        { "type": "listen", "ca": "Avui fa molt de fred", "options": ["Avui fa molt de fred", "Avui fa molt de calor", "Avui fa molt de vent"] }
      ]
    },
    {
      "id": "t3",
      "title": { "es": "Los meses del año", "ca": "Els mesos de l'any" },
      "goal": {
        "es": "Muchos meses son predecibles (-ero → -er). Los irregulares son maig y juny.",
        "ca": "Molts mesos: -ero → -er. Els irregulars: maig i juny."
      },
      "exercises": [
        {
          "type": "pattern",
          "rule": { "from": "-ero / -iembre", "to": "-er / -embre" },
          "examples": [
            { "es": "enero", "ca": "gener" },
            { "es": "febrero", "ca": "febrer" },
            { "es": "septiembre", "ca": "setembre" },
            { "es": "noviembre", "ca": "novembre" },
            { "es": "diciembre", "ca": "desembre" }
          ],
          "note": {
            "es": "-ero → -er (gener, febrer). -iembre → -embre (setembre, novembre, desembre). Los irregulares: mayo=maig, junio=juny.",
            "ca": "-ero → -er. -iembre → -embre. Irregulars: maig, juny."
          }
        },
        { "type": "flashcard", "ca": "gener", "es": "enero" },
        { "type": "flashcard", "ca": "febrer", "es": "febrero" },
        { "type": "flashcard", "ca": "març", "es": "marzo" },
        { "type": "flashcard", "ca": "abril", "es": "abril" },
        { "type": "flashcard", "ca": "maig", "es": "mayo",
          "note": { "es": "«Maig» con g final. Muy distinto del español.", "ca": "«Maig»: g final." } },
        { "type": "flashcard", "ca": "juny", "es": "junio" },
        { "type": "flashcard", "ca": "juliol", "es": "julio" },
        { "type": "flashcard", "ca": "agost", "es": "agosto" },
        { "type": "flashcard", "ca": "setembre", "es": "septiembre" },
        { "type": "flashcard", "ca": "octubre", "es": "octubre" },
        { "type": "flashcard", "ca": "novembre", "es": "noviembre" },
        { "type": "flashcard", "ca": "desembre", "es": "diciembre",
          "note": { "es": "«Desembre», no «diciembre».", "ca": "«Desembre», no «diciembre»." } },
        { "type": "compare",
          "es": "Nací en julio",
          "ca": "Vaig néixer al juliol",
          "note": { "es": "«Al juliol» (en julio). Con meses se usa «al» en catalán.", "ca": "«Al juliol»: preposició «a» + article." }
        },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "diciembre", "options": ["desembre", "desembe", "décembre", "diciembre"], "answer": "desembre" },
        { "type": "fill_blank",
          "sentence": "La primavera comença al ___.",
          "translation": "La primavera empieza en marzo.",
          "options": ["març", "abril"],
          "answer": "març" },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "mayo", "options": ["maig", "mayo", "may", "maigs"], "answer": "maig" }
      ]
    }
  ],
  "extras": [
    {
      "id": "x1",
      "title": { "es": "¿Qué tiempo hace?", "ca": "Quin temps fa?" },
      "goal": {
        "es": "Preguntar y describir el tiempo con más detalle.",
        "ca": "Preguntar i descriure el temps amb més detall."
      },
      "exercises": [
        { "type": "flashcard", "ca": "Quin temps fa?", "es": "¿Qué tiempo hace?" },
        { "type": "flashcard", "ca": "la pluja", "es": "la lluvia" },
        { "type": "flashcard", "ca": "la neu", "es": "la nieve",
          "note": { "es": "«La neu» = nieve. Verbo: «neva».", "ca": "«La neu» → verb: neva." } },
        { "type": "flashcard", "ca": "el paraigua", "es": "el paraguas" },
        { "type": "compare",
          "es": "¿Qué tiempo hará mañana?",
          "ca": "Quin temps farà demà?",
          "note": { "es": "«Farà» = hará (futuro de «fer»).", "ca": "Futur de fer: farà." }
        }
      ]
    }
  ]
}
