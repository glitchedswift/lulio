{
  "id": "1-4",
  "title": { "es": "Artículos", "ca": "Articles" },
  "goal": {
    "es": "Domina los artículos catalanes: el/la/els/les, un/una/uns/unes y la curiosa costumbre de poner artículo delante de los nombres.",
    "ca": "Domina els articles catalans i el costum de posar article davant dels noms."
  },
  "topics": [
    {
      "id": "t1",
      "title": { "es": "el / la / els / les", "ca": "el / la / els / les" },
      "goal": {
        "es": "El cambio clave: «los» → «els», «las» → «les». Una regla directa.",
        "ca": "El canvi clau: «los» → «els», «las» → «les»."
      },
      "exercises": [
        { "type": "flashcard", "ca": "el llibre", "es": "el libro" },
        { "type": "flashcard", "ca": "la casa", "es": "la casa" },
        {
          "type": "pattern",
          "rule": { "from": "los / las", "to": "els / les" },
          "examples": [
            { "es": "los libros", "ca": "els llibres" },
            { "es": "las casas", "ca": "les cases" },
            { "es": "los niños", "ca": "els nens" },
            { "es": "las niñas", "ca": "les nenes" }
          ],
          "note": {
            "es": "Regla directa sin excepciones: los → els, las → les. El singular (el/la) es igual.",
            "ca": "Regla directa: los → els, las → les. El singular (el/la) igual."
          }
        },
        { "type": "flashcard", "ca": "els nens", "es": "los niños",
          "note": { "es": "«els» = los. No existe «los» en catalán estándar.", "ca": "«els» = los." } },
        { "type": "flashcard", "ca": "les cases", "es": "las casas" },
        { "type": "compare",
          "es": "los libros",
          "ca": "els llibres",
          "note": { "es": "Recuerda: «los» en español → «els» en catalán.", "ca": "«los» → «els»." }
        },
        { "type": "fill_blank",
          "sentence": "___ pares són a casa.",
          "translation": "Los padres están en casa.",
          "options": ["Els", "Les"],
          "answer": "Els" },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "las niñas", "options": ["les nenes", "las nenes", "els nenes", "la nena"], "answer": "les nenes" }
      ]
    },
    {
      "id": "t2",
      "title": { "es": "un / una / uns / unes", "ca": "un / una / uns / unes" },
      "goal": {
        "es": "El plural masculino y femenino son «uns» y «unes», no «unos» y «unas».",
        "ca": "El plural és «uns» i «unes»."
      },
      "exercises": [
        { "type": "flashcard", "ca": "un cotxe", "es": "un coche" },
        { "type": "flashcard", "ca": "una taula", "es": "una mesa" },
        {
          "type": "pattern",
          "rule": { "from": "unos / unas", "to": "uns / unes" },
          "examples": [
            { "es": "unos amigos", "ca": "uns amics" },
            { "es": "unas amigas", "ca": "unes amigues" },
            { "es": "unos coches", "ca": "uns cotxes" },
            { "es": "unas mesas", "ca": "unes taules" }
          ],
          "note": {
            "es": "Mismo patrón que el definido: -os → -s. unos → uns, unas → unes. Más corto y fácil.",
            "ca": "Mateix patró: -os → -s. unos → uns, unas → unes."
          }
        },
        { "type": "flashcard", "ca": "uns amics", "es": "unos amigos" },
        { "type": "flashcard", "ca": "unes amigues", "es": "unas amigas" },
        { "type": "compare",
          "es": "unos perros",
          "ca": "uns gossos",
          "note": { "es": "«uns» en lugar de «unos». Y ojo: perro = «gos».", "ca": "«uns» en lloc de «unos»." }
        },
        { "type": "fill_blank",
          "sentence": "Tinc ___ amigues a Barcelona.",
          "translation": "Tengo unas amigas en Barcelona.",
          "options": ["unes", "uns"],
          "answer": "unes" },
        { "type": "translate", "direction": "es-ca",
          "prompt": "un coche y una mesa",
          "answer": "un cotxe i una taula",
          "bank": ["un", "cotxe", "i", "una", "taula"], "distractors": ["el", "y"] }
      ]
    },
    {
      "id": "t3",
      "title": { "es": "Artículos con nombres", "ca": "Articles amb noms" },
      "goal": {
        "es": "En catalán es habitual decir «el Joan» o «la Maria». En español no se hace.",
        "ca": "En català és habitual dir «el Joan» o «la Maria»."
      },
      "exercises": [
        { "type": "compare",
          "es": "Maria ha llegado",
          "ca": "La Maria ha arribat",
          "note": { "es": "El catalán pone artículo (el / la / l') delante de los nombres en el habla cotidiana.", "ca": "El català posa article davant dels noms en la parla quotidiana." }
        },
        { "type": "compare",
          "es": "Juan es mi amigo",
          "ca": "El Joan és el meu amic",
          "note": { "es": "Otro patrón típico catalán que sorprende a los hispanohablantes.", "ca": "Un patró que sorprèn els hispanoparlants." }
        },
        { "type": "flashcard", "ca": "L'Anna", "es": "Anna",
          "note": { "es": "Antes de vocal o «h», «la» se convierte en «l'».", "ca": "Davant de vocal o «h», «la» esdevé «l'»." } },
        { "type": "flashcard", "ca": "L'Òscar", "es": "Óscar" },
        { "type": "fill_blank",
          "sentence": "___ Joan és el meu germà.",
          "translation": "Juan es mi hermano.",
          "options": ["El", "L'"],
          "answer": "El" },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "Anna llega hoy", "options": ["L'Anna arriba avui", "La Anna arriba avui", "Anna arriba avui", "El Anna arriba avui"], "answer": "L'Anna arriba avui" }
      ]
    }
  ],
