        { "type": "compare",
          "es": "Estoy completamente de acuerdo",
          "ca": "Hi estic completament d'acord",
          "note": { "es": "«Hi» entre «estic» y «completament».", "ca": "Posició: hi + estic + completament." }
        },
        { "type": "compare",
          "es": "No estoy de acuerdo, lo siento",
          "ca": "No hi estic d'acord, ho sento",
          "note": { "es": "«Ho sento» = lo siento. Otro «ho» neutro.", "ca": "«Ho sento» = lo siento." }
        },
        { "type": "translate", "direction": "es-ca",
          "prompt": "Tienes razón",
          "answer": "Tens raó",
          "bank": ["Tens", "raó"],
          "distractors": ["razón", "tienes"] },
        { "type": "fill_blank",
          "sentence": "No ___ crec, em sembla rar.",
          "translation": "No lo creo, me parece raro.",
          "options": ["ho", "lo"],
          "answer": "ho" },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "Estoy de acuerdo", "options": ["Hi estic d'acord", "Estoy d'acord", "Estic acord", "Sóc d'acord"], "answer": "Hi estic d'acord" }
      ]
    },
    {
      "id": "t3",
      "title": { "es": "Argumentar", "ca": "Argumentar" },
      "goal": {
        "es": "Conectores: per tant, però, en canvi, malgrat.",
        "ca": "Connectors per argumentar."
      },
      "exercises": [
        { "type": "flashcard", "ca": "però", "es": "pero",
          "note": { "es": "«Però» con acento abierto. La «p» y la «r» son sonoras.", "ca": "«Però» amb accent obert." } },
        { "type": "flashcard", "ca": "en canvi", "es": "en cambio" },
        { "type": "flashcard", "ca": "per tant", "es": "por (lo) tanto" },
        { "type": "flashcard", "ca": "malgrat", "es": "a pesar de",
          "note": { "es": "«Malgrat» o «tot i». Más formal que «encara que».", "ca": "Formal: malgrat." } },
        { "type": "flashcard", "ca": "perquè", "es": "porque",
          "note": { "es": "Junto, con acento abierto: perquè. ¡Diferente del español!", "ca": "Tot junt: perquè." } },
        { "type": "compare",
          "es": "Quiero ir, pero no puedo",
          "ca": "Vull anar-hi, però no puc",
          "note": { "es": "«Anar-hi» = ir (allí). El pronombre «hi» va pegado al infinitivo.", "ca": "«Anar-hi»: pronom enganxat." }
        },
        { "type": "compare",
          "es": "No vino porque estaba enfermo",
          "ca": "No va venir perquè estava malalt",
          "note": { "es": "«Perquè» (porque, junto). «Per què» (separado) = ¿por qué?", "ca": "«Perquè» causal vs «per què» interrogatiu." }
        },
        { "type": "fill_blank",
          "sentence": "Plou, ___ portarem paraigua.",
          "translation": "Llueve, por (lo) tanto traeremos paraguas.",
          "options": ["per tant", "en canvi"],
          "answer": "per tant" },
        { "type": "translate", "direction": "es-ca",
          "prompt": "Vino aunque llovía",
          "answer": "Va venir malgrat que plovia",
          "bank": ["Va", "venir", "malgrat", "que", "plovia"],
          "distractors": ["aunque", "vino"] },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "porque", "options": ["perquè", "porque", "per què", "per que"], "answer": "perquè" }
      ]
    }
