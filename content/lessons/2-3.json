  "topics": [
    {
      "id": "t1",
      "title": { "es": "Comidas del día", "ca": "Els àpats" },
      "goal": {
        "es": "Esmorzar, dinar, sopar, berenar: aprende los nombres y sus falsos amigos.",
        "ca": "Esmorzar, dinar, sopar, berenar: noms i falsos amics."
      },
      "exercises": [
        { "type": "flashcard", "ca": "l'esmorzar", "es": "el desayuno",
          "note": { "es": "«Esmorzar» es también el verbo «desayunar». Lo mismo con dinar y sopar.", "ca": "«Esmorzar» també és el verb." } },
        { "type": "flashcard", "ca": "el dinar", "es": "la comida (mediodía)",
          "note": { "es": "Cuidado: «dinar» en catalán es la comida del mediodía, no la cena.", "ca": "«Dinar» = el menjar del migdia." } },
        { "type": "flashcard", "ca": "el sopar", "es": "la cena",
          "note": { "es": "«Sopar» = cenar. No tiene relación con la sopa («la sopa»).", "ca": "«Sopar» = el menjar de la nit." } },
        { "type": "flashcard", "ca": "el berenar", "es": "la merienda" },
        { "type": "compare",
          "es": "Comemos a las dos",
          "ca": "Dinem a les dues",
          "note": { "es": "«Comer» (mediodía) en catalán es «dinar». «Menjar» = comer (acto general).", "ca": "«Dinar» = comer al migdia. «Menjar» = comer en general." }
        },
        { "type": "compare",
          "es": "Cenamos a las nueve",
          "ca": "Sopem a les nou",
          "note": { "es": "«Sopar» = cenar. Falso amigo clásico con «sopa» (sopa).", "ca": "«Sopar» = cenar, no sopa." }
        },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "la cena", "options": ["el sopar", "la sopa", "el dinar", "la cena"], "answer": "el sopar" },
        { "type": "fill_blank",
          "sentence": "Avui ___ pasta amb tomàquet.",
          "translation": "Hoy comemos pasta con tomate.",
          "options": ["dinem", "sopem"],
          "answer": "dinem" }
      ]
    },
    {
      "id": "t2",
      "title": { "es": "Comida básica", "ca": "Menjar bàsic" },
      "goal": {
        "es": "El catalán es más conciso: pan→pa, leche→llet, carne→carn.",
        "ca": "El català és més concís: pa, llet, carn, peix."
