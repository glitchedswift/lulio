        { "type": "flashcard", "ca": "el peix", "es": "el pescado",
          "note": { "es": "«Peix» también significa «pez» (animal vivo).", "ca": "«Peix» = pez i pescado." } },
        { "type": "compare",
          "es": "Quiero pan con queso",
          "ca": "Vull pa amb formatge",
          "note": { "es": "«Amb» = con. Se pronuncia /am/.", "ca": "«Amb» es pronuncia /am/." }
        },
        { "type": "multiple_choice", "direction": "es-ca", "prompt": "el queso", "options": ["el formatge", "el queso", "la formatja", "el formatger"], "answer": "el formatge" },
        { "type": "translate", "direction": "es-ca",
          "prompt": "Pan, queso y fruta",
          "answer": "Pa formatge i fruita",
          "bank": ["Pa", "formatge", "i", "fruita"],
          "distractors": ["pan", "queso", "y", "fruta"] }
      ]
    },
    {
