        { "type": "flashcard", "ca": "el cafè", "es": "el café",
          "note": { "es": "Acento abierto: cafè.", "ca": "Accent obert: cafè." } },
        {
          "type": "compare",
          "es": "vino • cerveza • zumo",
          "ca": "vi • cervesa • suc",
          "note": {
            "es": "Vi (pierde -no), cervesa (z→s, patrón ya visto), suc (sin -mo). Bebidas concisas como la comida.",
            "ca": "Vi (perd -no), cervesa (z→s), suc. Begudes concises."
          }
        },
        { "type": "flashcard", "ca": "el te", "es": "el té",
          "note": { "es": "En catalán no lleva acento: «te».", "ca": "Sense accent: te." } },
        { "type": "flashcard", "ca": "el vi", "es": "el vino",
          "note": { "es": "Una sola letra: «vi». Sin la -no final.", "ca": "Sense -no: vi." } },
        { "type": "flashcard", "ca": "la cervesa", "es": "la cerveza" },
        { "type": "flashcard", "ca": "el suc", "es": "el zumo",
          "note": { "es": "«Suc» = zumo. También significa «jugo».", "ca": "«Suc» = zumo." } },
        { "type": "compare",
          "es": "Un café con leche, por favor",
          "ca": "Un cafè amb llet, si us plau",
          "note": { "es": "«Si us plau» = por favor.", "ca": "«Si us plau» = per favor." }
        },
        { "type": "translate", "direction": "es-ca",
          "prompt": "Un vino y una cerveza",
          "answer": "Un vi i una cervesa",
          "bank": ["Un", "vi", "i", "una", "cervesa"],
          "distractors": ["vino", "y", "cerveza"] },
        { "type": "fill_blank",
