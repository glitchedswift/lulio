{
  "id": "1-7",
  "title": { "es": "Patrón z → s / ç", "ca": "Patró z → s / ç" },
  "goal": {
    "es": "La Z española casi no existe en catalán. Aprende las tres formas en que se transforma y deducirás centenares de palabras.",
    "ca": "La Z castellana gairebé no existeix en català. Aprèn les tres formes en què es transforma."
  },
  "topics": [
    {
      "id": "t1",
      "title": { "es": "-eza → -esa", "ca": "-eza → -esa" },
      "goal": {
        "es": "Todos los sustantivos en -eza pasan a -esa. Sin excepciones notables.",
        "ca": "Tots els substantius en -eza passen a -esa. Sense excepcions notables."
      },
      "xp": 15,
      "exercises": [
        {
          "type": "compare",
          "es": "cerveza · plaza · feliz",
          "ca": "cervesa · plaça · feliç",
          "note": {
            "es": "La Z española no existe en catalán. Se convierte en S, Ç o SS según dónde aparece.",
            "ca": "La Z castellana no existeix en català. Es converteix en S, Ç o SS."
          }
        },
        {
          "type": "pattern",
          "rule": { "from": "-eza", "to": "-esa" },
          "examples": [
            { "es": "riqueza", "ca": "riquesa" },
            { "es": "naturaleza", "ca": "naturalesa" },
            { "es": "tristeza", "ca": "tristesa" },
            { "es": "belleza", "ca": "bellesa" },
            { "es": "pureza", "ca": "puresa" },
            { "es": "grandeza", "ca": "grandesa" }
          ],
          "note": {
            "es": "Más de cien sustantivos siguen este patrón. Z intervocálica → S.",
            "ca": "Més de cent substantius segueixen aquest patró. Z intervocàlica → S."
          }
        },
        {
          "type": "multiple_choice",
          "direction": "es-ca",
          "prompt": "belleza",
          "options": ["bellesa", "belleza", "bellessa", "bellea"],
          "answer": "bellesa"
        },
        {
          "type": "fill_blank",
          "sentence": "La ___ dels Pirineus és impressionant.",
          "translation": "La belleza de los Pirineos es impresionante.",
          "options": ["bellesa", "belleza", "bellíssima", "bellor"],
          "answer": "bellesa"
        },
        {
          "type": "translate",
          "direction": "es-ca",
          "prompt": "La riqueza de este país",
          "answer": "La riquesa d'aquest país",
          "bank": ["La", "riquesa", "d'aquest", "país"],
          "distractors": ["riqueza", "este"]
        }
      ]
    },
    {
      "id": "t2",
      "title": { "es": "z final → ç", "ca": "z final → ç" },
      "goal": {
        "es": "Cuando la Z va al final de palabra, en catalán se escribe Ç (ce trencada).",
        "ca": "Quan la Z va al final de paraula, en català s'escriu Ç (ce trencada)."
      },
      "xp": 15,
      "exercises": [
        {
          "type": "pattern",
          "rule": { "from": "z (final)", "to": "ç" },
          "examples": [
            { "es": "feliz", "ca": "feliç" },
            { "es": "capaz", "ca": "capaç" },
            { "es": "eficaz", "ca": "eficaç" },
            { "es": "tenaz", "ca": "tenaç" },
            { "es": "esperanza", "ca": "esperança" },
            { "es": "brazo", "ca": "braç" }
          ],
          "note": {
            "es": "La Ç suena igual que la S. En el plural vuelve la C: feliç → feliços.",
            "ca": "La Ç sona com la S. Al plural torna la C: feliç → feliços."
          }
        },
        {
          "type": "multiple_choice",
          "direction": "es-ca",
          "prompt": "feliz",
          "options": ["feliç", "feliz", "feliçs", "felis"],
          "answer": "feliç"
        },
        {
          "type": "multiple_choice",
          "direction": "es-ca",
          "prompt": "esperanza",
          "options": ["esperança", "esperanza", "esperansa", "esperanssa"],
          "answer": "esperança"
        },
        {
          "type": "fill_blank",
          "sentence": "Tinc la ___ de guanyar.",
          "translation": "Tengo la esperanza de ganar.",
          "options": ["esperança", "esperanza", "esperansa", "esper"],
          "answer": "esperança"
        },
        {
          "type": "translate",
          "direction": "es-ca",
          "prompt": "Estoy muy feliz",
          "answer": "Estic molt feliç",
          "bank": ["Estic", "molt", "feliç"],
          "distractors": ["muy", "feliz", "felis"]
        }
      ]
    },
    {
      "id": "t3",
      "title": { "es": "z ante a/o/u → ç", "ca": "z davant a/o/u → ç" },
      "goal": {
        "es": "Antes de A, O, U → Ç (plaça, força). En otros contextos → S o SS.",
        "ca": "Davant de A, O, U → Ç (plaça, força). En altres contextos → S o SS."
      },
      "xp": 15,
      "exercises": [
        {
          "type": "pattern",
          "rule": { "from": "z + a/o/u", "to": "ç" },
          "examples": [
            { "es": "plaza", "ca": "plaça" },
            { "es": "fuerza", "ca": "força" },
            { "es": "cerveza", "ca": "cervesa" },
            { "es": "trozo", "ca": "tros" },
            { "es": "taza", "ca": "tassa" },
            { "es": "arroz", "ca": "arròs" }
          ],
          "note": {
            "es": "plaça/força → ç ante a/o. cervesa/tros → s. tassa → ss (la s simple entre vocales suena /z/ en català, hay que doblarla).",
            "ca": "plaça/força → ç davant a/o. cervesa/tros → s. tassa → ss (la s simple entre vocals sona /z/ en català)."
          }
        },
        {
          "type": "multiple_choice",
          "direction": "es-ca",
          "prompt": "cerveza",
          "options": ["cervesa", "cerveza", "cerveça", "cervessa"],
          "answer": "cervesa"
        },
        {
          "type": "multiple_choice",
          "direction": "es-ca",
          "prompt": "fuerza",
          "options": ["força", "fuerça", "fuerza", "forsa"],
          "answer": "força"
        },
        {
          "type": "compare",
          "es": "una taza de café",
          "ca": "una tassa de cafè",
          "note": {
            "es": "S doble entre vocales → SS. La S simple entre vocales suena /z/ en catalán.",
            "ca": "S doble entre vocals → SS. La S simple entre vocals sona /z/."
          }
        },
        {
          "type": "fill_blank",
          "sentence": "Vull un ___ de pa amb tomàquet.",
          "translation": "Quiero un trozo de pan con tomate.",
          "options": ["tros", "trozo", "troc", "tross"],
          "answer": "tros"
        },
        {
          "type": "listen",
          "ca": "La plaça és molt gran",
          "options": ["La plaça és molt gran", "La plaza és molt gran", "La plaça és molt petit"]
        }
      ]
    }
  ],
  "extras": [
    {
      "id": "x1",
      "title": { "es": "La doble ss", "ca": "La doble ss" },
      "goal": {
        "es": "En catalán, la S entre vocales suena /z/. Para el sonido /s/ entre vocales se escribe SS.",
        "ca": "En català, la S entre vocals sona /z/. Per al so /s/ entre vocals cal escriure SS."
      },
      "exercises": [
        {
          "type": "compare",
          "es": "casa → /kása/",
          "ca": "casa → /kázə/",
          "note": {
            "es": "En catalán la S entre vocales suena /z/. No hace falta doblarla si el sonido original ya era /z/.",
            "ca": "En català la S entre vocals sona /z/. No cal doblar-la si el so original ja era /z/."
          }
        },
        { "type": "flashcard", "ca": "la tassa", "es": "la taza",
          "note": { "es": "SS porque la S simple entre vocales sonaría /z/.", "ca": "SS per mantenir el so /s/ entre vocals." } },
        { "type": "flashcard", "ca": "massa", "es": "demasiado",
          "note": { "es": "SS: mismo motivo.", "ca": "SS: mateix motiu." } },
        { "type": "flashcard", "ca": "la pressió", "es": "la presión",
          "note": { "es": "SS ante vocal: pressió.", "ca": "SS davant vocal: pressió." } }
      ]
    }
  ]
}
